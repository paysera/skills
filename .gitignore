# Every directory name in validate.py's SKIP_DIRS must be listed here. The gate does not
# scan those directories, so anything inside one is invisible to the publication check —
# keeping them untracked is what makes that safe. test_validate.py enforces the pairing.
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.venv/
venv/
node_modules/
.idea/
.vscode/
.DS_Store
